TELEGRAM_BOT_TOKEN=replace-me
COINALYZE_API_KEY=replace-me
BITMEX_ALERT_CHAT_IDS=
BITMEX_WHALE_TRADE_THRESHOLD=1000000
BITMEX_WHALE_POLL_INTERVAL_SECONDS=15
BITMEX_AUTO_REGISTER_ON_MARKET_INTERACTION=1

GEMINI_CASUAL_ENABLED=0
LOCAL_QWEN_ENABLED=1
# Ubuntu 기본 경로는 Ollama 로컬 API를 전제로 합니다.
LOCAL_QWEN_BACKEND=ollama
LOCAL_QWEN_OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_QWEN_OLLAMA_MODEL=gemma4:e4b
LOCAL_QWEN_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LOCAL_QWEN_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_QWEN_CACHE_DIR=/opt/grannybot/model-cache
LOCAL_QWEN_THREADS=2
LOCAL_QWEN_CTX=2048
LOCAL_QWEN_N_BATCH=128
LOCAL_QWEN_MAX_TOKENS=160
